{
    "manifest_version": 3,
    "name": "7TV Mod Log Filters",
    "version": "0.1.4",
    "description": "Fitler 7TV moderation logs on Twitch.",
    "content_scripts": [
        {
            "matches": ["https://www.twitch.tv/*"],
            "js": ["content.js"],
            "css": ["styles.css"],
            "run_at": "document_idle"
        }
    ]
}